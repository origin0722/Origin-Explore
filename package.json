{
  "name": "origin-explore",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "description": "OriginExplore — AI 结构化思维与知识探索工具（纯前端 + BYOK + 桌面版）",
  "author": "origin0722",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/origin0722/Origin-Explore.git"
  },
  "homepage": "https://github.com/origin0722/Origin-Explore",
  "bugs": {
    "url": "https://github.com/origin0722/Origin-Explore/issues"
  },
  "keywords": [
    "origin-explore",
    "ai",
    "knowledge-exploration",
    "structured-thinking",
    "nextjs",
    "electron",
    "byok",
    "tailwindcss",
    "shadcn-ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:web": "node scripts/start-web.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "gen:icon": "node scripts/gen-icon.mjs",
    "package:app": "node scripts/package-app.mjs"
  },
  "build": {
    "appId": "com.origin.explore",
    "productName": "OriginExplore",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/main.js",
      "electron/loading.html",
      "package.json",
      "!node_modules/**/*"
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "afterPack": "scripts/after-pack.mjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "OriginExplore-${version}-setup.exe"
    },
    "compression": "maximum",
    "portable": {
      "artifactName": "OriginExplore-${version}-portable.exe"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.6.0",
    "mammoth": "^1.12.1",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.5.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.5.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
